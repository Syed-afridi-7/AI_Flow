# AI_Flow API Keys Configuration
# Copy this file to .env and fill in the keys you want to use.
# Note: .env is automatically gitignored and will never be committed.

# Google Gemini API Key (Get at: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI ChatGPT API Key (Get at: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Optional)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# xAI Grok API Key (Get at: https://console.x.ai/)
GROK_API_KEY=your_grok_api_key_here

